# Long random string used to sign login tokens (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me
# Public URL of the deployed app, no trailing slash. Every link sent through viaSocket is built from this.
APP_URL=http://localhost:5000
# viaSocket webhook URL of the "Did it help?" ask flow (server-side only)
VIASOCKET_ASK_WEBHOOK_URL=
# viaSocket webhook URL of the "team invite" flow (sends the invite link to the new person's Slack or email)
VIASOCKET_INVITE_WEBHOOK_URL=
# Secret for /api/today and /api/digest (use ?key=<DIGEST_KEY>)
DIGEST_KEY=change-me-too

# Optional
# Where the SQLite database file lives. On a host, point this at a persistent disk (e.g. /var/data/did-it-help.db)
DATABASE_PATH=./server/data/did-it-help.db
PORT=5000
# IANA timezone that decides what "today" and the Monday-Sunday week mean
APP_TIMEZONE=Asia/Kolkata

# viaSocket embed (server-side only)
VIASOCKET_ORG_ID=
VIASOCKET_PROJECT_ID=
VIASOCKET_EMBED_SECRET=
