# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/did-it-help?retryWrites=true&w=majority
# Long random string used to sign login tokens (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me
# Public URL of the deployed app, no trailing slash. Every link sent through viaSocket is built from this.
APP_URL=http://localhost:5000
# viaSocket webhook URL of the "Did it help?" ask flow (server-side only)
VIASOCKET_ASK_WEBHOOK_URL=
# Secret for /api/today and /api/digest (use ?key=<DIGEST_KEY>)
DIGEST_KEY=change-me-too

# Optional
PORT=5000
# IANA timezone that decides what "today" and the Monday-Sunday week mean
APP_TIMEZONE=Asia/Kolkata
